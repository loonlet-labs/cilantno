{
  "name": "cilantno",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot ./server.ts",
    "build": "bun build ./index.html --outdir ./dist --minify",
    "test": "bun test",
