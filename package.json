  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/bun": "latest",
    "@types/three": "^0.186.0",
    "wrangler": "^4.148.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
